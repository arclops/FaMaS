# ---------------------------------------------------------------------------
# FaMaS API — environment template
# Copy to server/.env and fill in real values:  cp server/.env.example server/.env
# Never commit server/.env (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# Port the Express API listens on. Docker/Render/Railway/Fly inject their own.
PORT=5000
NODE_ENV=development

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. When unset
# the API falls back to http://localhost:3030, so a fresh checkout works.
# Add your deployed client origin(s), including Vercel previews, e.g.
# ALLOWED_ORIGINS=http://localhost:3030,https://<your-app>.vercel.app,https://famas-*.vercel.app
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3031

# --- Database --------------------------------------------------------------
# Preferred for managed hosts: ONE connection string, as provided by
# Render/Railway/Fly/Heroku. When set it overrides the PG* group below.
# Leave it COMMENTED OUT for docker compose, where the service name `postgres`
# is only resolvable inside the cluster.
# POSTGRES_URL=postgres://famas:famas@localhost:5432/famas

# Discrete variables (used when POSTGRES_URL is unset). These are the same
# names the official `postgres` Docker image consumes, so docker compose drives
# the database container from these values.
PGHOST=localhost
PGPORT=5432
PGUSER=famas
PGPASSWORD=famas
PGDATABASE=famas

# Set to true for managed providers that require TLS (Render, Railway, Fly).
PGSSL=false

# --- Startup resilience ----------------------------------------------------
# How many times to retry the initial PostgreSQL connection, and the delay
# between attempts. Defaults: 1 attempt / 2000 ms. Raise DB_CONNECT_RETRIES
# when the API may start before the database is accepting connections.
DB_CONNECT_RETRIES=1
DB_CONNECT_RETRY_DELAY_MS=2000

# --- Auth ------------------------------------------------------------------
# REQUIRED. Signing key for the 2-hour JWTs issued at login. Use a long random
# string; rotating it invalidates all active sessions.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
