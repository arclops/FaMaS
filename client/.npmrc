# The Minimal-derived dependency tree has an unresolved peer conflict:
# @mui/styles@5.x declares peer react@^17 while this app runs react@18.
# npm 6 (Node 14/16 era, when this app was first deployed) ignored peer
# conflicts; npm 7+ aborts the install instead, which breaks CI. Pinning the
# legacy behaviour keeps `npm ci` and `npm install` working on modern Node.
legacy-peer-deps=true
