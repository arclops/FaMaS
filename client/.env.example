# ----------------------------------------------------------------------
# FaMaS client — environment variables (copy to .env.local for local dev,
# or set them in the Vercel project for the deployed demo).
#
# Nothing here is required for the demo: with VITE_API_URL unset the client
# automatically falls back to the seeded in-memory mock (see src/api/client.js
# and src/api/mock/).
# ----------------------------------------------------------------------

# Base URL of the FaMaS backend (Express app in ../server), WITHOUT a trailing
# slash. Every call site appends its own "/api/..." path.
# Leave unset (or set VITE_DEMO_MODE=true) to run fully backend-less.
VITE_API_URL=

# 'true'  -> force the in-memory mock backend (seeded demo data).
# 'false' -> disable the mock. Only honoured when VITE_API_URL is set;
#            with VITE_DEMO_MODE=false and no VITE_API_URL the client still
#            falls back to demo mode rather than requesting undefined/api/...
# Unset   -> demo mode when VITE_API_URL is unset, real backend otherwise.
VITE_DEMO_MODE=true

# ----------------------------------------------------------------------
# Cloudinary (product image upload — src/sections/products/modals/addproduct.jsx
# and the commented-out config at the top of that file).
# Without these the image upload returns undefined and the new product is
# stored with the placeholder image; the product itself still gets created.
# ----------------------------------------------------------------------

# Cloudinary cloud name, e.g. "famas-demo"
VITE_CNARY_CLOUD_NAME=

# Cloudinary API key / secret. NOTE: the uploaded `upload_preset` must be an
# UNSIGNED preset — these values are shipped to the browser either way, so an
# api_secret in a VITE_* variable is readable by anyone who opens devtools.
# Prefer a signed upload endpoint on the server over VITE_CNARY_SECRET.
VITE_CNARY_API_KEY=
VITE_CNARY_SECRET=

# Unsigned upload preset used by the product image uploader.
VITE_CNARY_UP_PRESET=
